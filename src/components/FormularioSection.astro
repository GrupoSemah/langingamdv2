---
// Sección secundaria/alternativa al CTA de WhatsApp de #cotizacion.
// Aloja el mecanismo de formulario original (CotizacionFormPreview + CotizacionModal),
// reubicado aquí — justo antes del footer — para que NO compita visualmente con el CTA
// de WhatsApp, que sigue siendo la vía principal en la sección #cotizacion.
// Jerarquía deliberada: fondo neutro, card sin sombra pronunciada, tipografía más
// pequeña que #cotizacion. Contenido minimalista: un solo encabezado corto + form.
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import CotizacionFormPreview from './CotizacionFormPreview.astro';
import CotizacionModal from './CotizacionModal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="formulario" class="border-t border-gray-100 bg-gray-50 py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      <h2 class="text-2xl font-bold text-[var(--color-dark)] sm:text-3xl">
        {t('quote.form.title')}
      </h2>
    </div>

    <!-- Card discreta: borde sutil, sombra ligera (vs. shadow-2xl de la card naranja) -->
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <CotizacionFormPreview />
    </div>
  </div>
</section>

<CotizacionModal />
