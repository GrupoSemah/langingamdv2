---
// Botón flotante de WhatsApp, global en todas las páginas (ES/EN).
// Convive con el formulario de cotización (FormularioKommo) — no lo reemplaza.
// Ícono: WhatsAppIcon compartido (mismo glifo oficial que el CTA de CotizacionWhatsApp.astro).
import { getLangFromUrl } from '../i18n/utils';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const lang = getLangFromUrl(Astro.url);

const WHATSAPP_NUMBER = '50767815555';

// Mensaje pre-rellenado por idioma. Ahora el flujo es: click en el botón → se abre el modal de
// cotización (Quiz completo) → al enviarlo, se abre WhatsApp — por eso el mensaje ya asume que
// el usuario completó el formulario, en vez del saludo genérico de "vi su página" de antes.
const prefilledMessages = {
	es: 'Hola, acabo de completar el formulario de cotización en la web y quiero continuar por acá.',
	en: 'Hi, I just completed the quote form on the website and would like to continue here.',
} as const;

const labels = {
	es: {
		aria: 'Chatear por WhatsApp',
		tooltip: 'Escríbenos por WhatsApp',
	},
	en: {
		aria: 'Chat on WhatsApp',
		tooltip: 'Message us on WhatsApp',
	},
} as const;

const whatsappMessage = prefilledMessages[lang];
const { aria: ariaLabel, tooltip: tooltipText } = labels[lang];
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessage)}`;
---

<button
	type="button"
	id="whatsapp-float-button"
	class="group fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform duration-200 ease-out hover:scale-110 hover:bg-[#20BD5A] focus-visible:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 md:right-6 md:bottom-6 md:h-16 md:w-16"
	aria-label={ariaLabel}
	data-whatsapp-url={whatsappUrl}
>
	<WhatsAppIcon class="relative h-7 w-7 md:h-8 md:w-8" />

	<span
		class="tooltip-label pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-md bg-[var(--color-dark)] px-3 py-1.5 text-sm font-medium text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 md:block"
		aria-hidden="true"
	>
		{tooltipText}
	</span>
</button>

<script>
	// El botón vive en Layout.astro y persiste en el DOM entre navegaciones de
	// astro:transitions, pero el registro del listener se re-ejecuta explícitamente
	// en cada 'astro:page-load' (incluye la carga inicial) para no depender de que
	// Astro reutilice el mismo nodo tras cada swap de página.
	//
	// Flujo actual: click → abre el modal de cotización (CotizacionModal, hoisteado en
	// Layout.astro) en modo 'whatsapp'. El propio modal navega a WhatsApp al enviar el Quiz;
	// la conversión de Google Ads se dispara desde ahí (unificada), no en este click.
	function initWhatsAppFloatButton() {
		const button = document.getElementById('whatsapp-float-button');

		if (button && button.dataset.whatsappModalBound !== 'true') {
			button.dataset.whatsappModalBound = 'true';

			button.addEventListener('click', () => {
				document.dispatchEvent(
					new CustomEvent('amd:open-modal', {
						detail: {
							mode: 'whatsapp',
							whatsappUrl: button.dataset.whatsappUrl ?? '',
							source: 'floating-button',
						},
					}),
				);
			});
		}
	}

	document.addEventListener('astro:page-load', initWhatsAppFloatButton);
</script>

<style>
	/* Sombra en capas (contenida, sin difuminado) + anillo de pulso discreto.
	   Reemplaza el halo verde difuso anterior (círculo duplicado con blur/scale) por un
	   drop shadow limpio en reposo y un anillo delgado que se expande y se desvanece,
	   sin relleno, para un acabado pulido en vez de un "glow" amateur. */
	#whatsapp-float-button {
		box-shadow:
			0 4px 14px rgba(0, 0, 0, 0.18),
			0 2px 4px rgba(0, 0, 0, 0.12);
		animation: whatsapp-pulse 2.8s ease-out infinite;
	}

	@keyframes whatsapp-pulse {
		0% {
			box-shadow:
				0 4px 14px rgba(0, 0, 0, 0.18),
				0 2px 4px rgba(0, 0, 0, 0.12),
				0 0 0 0 rgba(37, 211, 102, 0.35);
		}
		70%,
		100% {
			box-shadow:
				0 4px 14px rgba(0, 0, 0, 0.18),
				0 2px 4px rgba(0, 0, 0, 0.12),
				0 0 0 10px rgba(37, 211, 102, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#whatsapp-float-button {
			animation: none;
			transition: none;
		}
	}

	/* Respeta el safe-area de dispositivos con notch/home indicator */
	#whatsapp-float-button {
		right: max(1.25rem, env(safe-area-inset-right));
		bottom: max(1.25rem, env(safe-area-inset-bottom));
	}

	@media (min-width: 768px) {
		#whatsapp-float-button {
			right: max(1.5rem, env(safe-area-inset-right));
			bottom: max(1.5rem, env(safe-area-inset-bottom));
		}
	}
</style>
