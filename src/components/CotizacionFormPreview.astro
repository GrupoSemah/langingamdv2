---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
  Réplica visual del formulario de cotización.
  Los inputs son presentacionales (readonly + tabindex=-1).
  Un overlay invisible captura cualquier interacción y dispara el modal.
-->
<div
  id="cotizacion-preview-wrapper"
  class="cotizacion-preview"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
  aria-label="Abrir formulario de cotización"
>
  <!-- Overlay que cubre todo el form y captura clicks/touch -->
  <div
    id="cotizacion-overlay"
    class="cotizacion-overlay"
    aria-hidden="true"
  ></div>

  <form
    class="space-y-4"
    aria-hidden="true"
    tabindex="-1"
    onsubmit="return false;"
  >
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        {t('form.name')}
      </label>
      <input
        type="text"
        readonly
        tabindex="-1"
        placeholder={t('form.name.placeholder')}
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all cursor-pointer bg-white"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        {t('form.phone')}
      </label>
      <input
        type="tel"
        readonly
        tabindex="-1"
        placeholder={t('form.phone.placeholder')}
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all cursor-pointer bg-white"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        {t('form.email')}
      </label>
      <input
        type="email"
        readonly
        tabindex="-1"
        placeholder={t('form.email.placeholder')}
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all cursor-pointer bg-white"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        {t('form.company')}
      </label>
      <input
        type="text"
        readonly
        tabindex="-1"
        placeholder={t('form.company.placeholder')}
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all cursor-pointer bg-white"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        {t('form.branch')}
      </label>
      <!-- Select presentacional: pointer-events-none en el elemento, overlay lo cubre -->
      <div class="relative">
        <select
          tabindex="-1"
          disabled
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all bg-white cursor-pointer appearance-none text-gray-400"
        >
          <option value="">{t('form.branch.placeholder')}</option>
        </select>
        <!-- Flecha decorativa del select -->
        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <button
      type="button"
      tabindex="-1"
      class="w-full bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold py-3 px-6 rounded-lg hover:from-orange-600 hover:to-orange-700 transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl cursor-pointer"
    >
      {t('form.submit')}
    </button>
  </form>
</div>

<style>
  .cotizacion-preview {
    width: 100%;
    position: relative;
    cursor: pointer;
    border-radius: 0.5rem;
    outline: none;
  }

  /* El overlay cubre todo el área del form */
  .cotizacion-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    cursor: pointer;
    /* Transparente pero captura eventos táctiles y de mouse */
    background: transparent;
    -webkit-tap-highlight-color: transparent;
    border-radius: inherit;
  }

  /* Estado focus visible para accesibilidad de teclado */
  .cotizacion-preview:focus-visible {
    outline: 3px solid rgb(249 115 22);
    outline-offset: 2px;
  }

  /* Sutil feedback visual al hover */
  .cotizacion-preview:hover .cotizacion-overlay {
    background: rgba(249, 115, 22, 0.03);
  }
</style>

<script>
  function initPreview() {
    const wrapper = document.getElementById('cotizacion-preview-wrapper');
    if (!wrapper) return;

    const openModal = () => {
      const event = new CustomEvent('amd:open-modal', { bubbles: true });
      wrapper.dispatchEvent(event);
    };

    // Click / tap en el wrapper o el overlay
    wrapper.addEventListener('click', openModal);

    // Teclado: Enter y Space abren el modal (accesibilidad)
    wrapper.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal();
      }
    });

    // Tab que llegue al wrapper (por si el usuario navega con teclado hasta acá)
    wrapper.addEventListener('focus', () => {
      // Solo abrir si el foco provino de Tab (no de un click que ya disparó openModal)
      // Se detecta con un pequeño state para evitar doble apertura
    });
  }

  // Inicializar en primera carga y en cada navegación de Astro
  document.addEventListener('astro:page-load', initPreview);
  initPreview();
</script>
