---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// URL del form standalone — se configura en .env como PUBLIC_FORM_URL
// Fallback también cubre string vacío/whitespace (env declarada pero sin valor en el deploy)
const rawFormUrl = import.meta.env.PUBLIC_FORM_URL;
const formUrl = rawFormUrl?.trim() ? rawFormUrl.trim() : 'https://leadform.almacenajes.net';
const currentLang = lang;
---

<!--
  Modal de cotización con iframe al form standalone.
  Accesible: focus trap, cierre con Esc, backdrop click, botón X.
  postMessage: escucha { type: 'amd-lead-submitted' } del iframe para cerrar y redirigir.
-->
<div
  id="cotizacion-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
  class="cotizacion-modal"
  data-form-url={formUrl}
  data-lang={currentLang}
>
  <!-- Backdrop -->
  <div id="cotizacion-backdrop" class="cotizacion-backdrop" aria-hidden="true"></div>

  <!-- Panel del modal -->
  <div class="cotizacion-panel" role="document">
    <!-- Header -->
    <div class="cotizacion-header">
      <h2 id="modal-title" class="cotizacion-title">
        {lang === 'en' ? 'Get your quote at Almacenajes SA' : 'Cotiza tu espacio en Almacenajes SA'}
      </h2>
      <button
        id="cotizacion-close"
        type="button"
        aria-label={lang === 'en' ? 'Close form' : 'Cerrar formulario'}
        class="cotizacion-close-btn"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Iframe con spinner de carga -->
    <div class="cotizacion-iframe-wrapper">
      <!-- Spinner mientras carga el iframe -->
      <div id="cotizacion-spinner" class="cotizacion-spinner" aria-hidden="true">
        <div class="spinner-ring"></div>
        <p class="spinner-text">{t('common.loading')}</p>
      </div>

      <iframe
        id="cotizacion-iframe"
        title={lang === 'en' ? 'Storage quote form' : 'Formulario de cotización de almacenaje'}
        class="cotizacion-iframe"
        loading="lazy"
        allow="clipboard-write"
        sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-top-navigation-by-user-activation"
      ></iframe>
    </div>
  </div>
</div>

<style>
  /* ── Backdrop ───────────────────────────────────────────────────── */
  .cotizacion-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    /* Oculto por defecto */
    visibility: hidden;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .cotizacion-modal {
      align-items: center;
      padding: 1rem;
    }
  }

  .cotizacion-modal.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .cotizacion-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 250ms ease;
    cursor: pointer;
  }

  .cotizacion-modal.is-open .cotizacion-backdrop {
    opacity: 1;
  }

  /* ── Panel ──────────────────────────────────────────────────────── */
  .cotizacion-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 600px;
    background: #ffffff;
    border-radius: 1.25rem 1.25rem 0 0;
    box-shadow:
      0 25px 60px -12px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(100%);
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
    max-height: 92dvh;
  }

  @media (min-width: 640px) {
    .cotizacion-panel {
      border-radius: 1.25rem;
      transform: scale(0.95) translateY(8px);
      transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 250ms ease;
      opacity: 0;
      max-height: 90dvh;
    }
  }

  .cotizacion-modal.is-open .cotizacion-panel {
    transform: translateY(0);
  }

  @media (min-width: 640px) {
    .cotizacion-modal.is-open .cotizacion-panel {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .cotizacion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    flex-shrink: 0;
  }

  .cotizacion-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin: 0;
  }

  @media (min-width: 640px) {
    .cotizacion-title {
      font-size: 1.125rem;
    }
  }

  /* Acento naranja en el título */
  .cotizacion-title::before {
    content: '';
    display: inline-block;
    width: 0.25rem;
    height: 1em;
    background: linear-gradient(to bottom, #f97316, #ea580c);
    border-radius: 9999px;
    margin-right: 0.625rem;
    vertical-align: middle;
    position: relative;
    top: -0.05em;
  }

  .cotizacion-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: none;
    background: #f3f4f6;
    color: #4b5563;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .cotizacion-close-btn:hover {
    background: #fee2e2;
    color: #dc2626;
    transform: scale(1.08);
  }

  .cotizacion-close-btn:focus-visible {
    outline: 3px solid #f97316;
    outline-offset: 2px;
  }

  /* ── Iframe wrapper ──────────────────────────────────────────────── */
  .cotizacion-iframe-wrapper {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .cotizacion-iframe {
    width: 100%;
    height: 100%;
    min-height: 560px;
    border: none;
    display: block;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  @media (min-width: 640px) {
    .cotizacion-iframe {
      min-height: 620px;
    }
  }

  .cotizacion-iframe.is-loaded {
    opacity: 1;
  }

  /* ── Spinner ─────────────────────────────────────────────────────── */
  .cotizacion-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: #fff;
    z-index: 1;
    transition: opacity 300ms ease;
  }

  .cotizacion-spinner.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .spinner-ring {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid #fed7aa;
    border-top-color: #f97316;
    border-radius: 50%;
    animation: spin 0.75s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .spinner-text {
    font-size: 0.875rem;
    color: #9ca3af;
    margin: 0;
  }
</style>

<script>
  // ─── Tipos ───────────────────────────────────────────────────────────────────

  interface AmdPostMessage {
    type: string;
  }

  // ─── Estado del módulo ───────────────────────────────────────────────────────

  let isModalOpen = false;
  let focusTrapElements: HTMLElement[] = [];
  let lastFocusedElement: HTMLElement | null = null;

  // ─── Helpers ─────────────────────────────────────────────────────────────────

  function getModal(): HTMLElement | null {
    return document.getElementById('cotizacion-modal');
  }

  function getIframe(): HTMLIFrameElement | null {
    return document.getElementById('cotizacion-iframe') as HTMLIFrameElement | null;
  }

  function getSpinner(): HTMLElement | null {
    return document.getElementById('cotizacion-spinner');
  }

  function openModal() {
    if (isModalOpen) return;
    isModalOpen = true;

    const modal = getModal();
    if (!modal) return;

    // Guardar elemento con foco actual para restaurarlo al cerrar
    lastFocusedElement = document.activeElement as HTMLElement;

    // Cargar el iframe solo al abrir (lazy). Usamos un flag propio porque
    // iframe.src nunca es "" en el DOM (resuelve a la URL base), por lo que
    // no sirve como condicion de "aun no cargado".
    const iframe = getIframe();
    const formUrl = modal.dataset.formUrl ?? '';
    const lang = modal.dataset.lang ?? 'es';

    if (iframe && iframe.dataset.loaded !== 'true') {
      try {
        const url = new URL(formUrl);
        url.searchParams.set('lang', lang);
        iframe.src = url.toString();
        iframe.dataset.loaded = 'true';
      } catch (err) {
        console.error('PUBLIC_FORM_URL invalida o no definida:', formUrl, err);
      }
    }

    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';

    // Focus trap: mover el foco al botón de cierre
    const closeBtn = document.getElementById('cotizacion-close');
    closeBtn?.focus();

    setupFocusTrap(modal);
  }

  function closeModal() {
    if (!isModalOpen) return;
    isModalOpen = false;

    const modal = getModal();
    if (!modal) return;

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    // Restaurar foco al elemento que lo tenía antes
    lastFocusedElement?.focus();
    lastFocusedElement = null;

    removeFocusTrap();
  }

  function setupFocusTrap(modal: HTMLElement) {
    const focusable = modal.querySelectorAll<HTMLElement>(
      'button, [href], input:not([tabindex="-1"]), select:not([tabindex="-1"]), textarea, [tabindex]:not([tabindex="-1"])'
    );
    focusTrapElements = Array.from(focusable);

    modal.addEventListener('keydown', handleFocusTrap);
  }

  function removeFocusTrap() {
    const modal = getModal();
    modal?.removeEventListener('keydown', handleFocusTrap);
    focusTrapElements = [];
  }

  function handleFocusTrap(e: Event) {
    const ke = e as KeyboardEvent;
    if (ke.key !== 'Tab') return;
    if (focusTrapElements.length === 0) return;

    const first = focusTrapElements[0];
    const last = focusTrapElements[focusTrapElements.length - 1];

    if (ke.shiftKey) {
      if (document.activeElement === first) {
        ke.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        ke.preventDefault();
        first.focus();
      }
    }
  }

  // ─── Listener postMessage del iframe ────────────────────────────────────────

  function handleIframeMessage(e: MessageEvent) {
    const modal = getModal();
    if (!modal) return;

    const formUrl = modal.dataset.formUrl ?? '';

    // Validar origin contra la URL configurada (seguridad básica)
    let allowedOrigin: string;
    try {
      allowedOrigin = new URL(formUrl).origin;
    } catch {
      // formUrl inválida o vacía en el dataset — hace visible un problema de configuración
      console.warn('[CotizacionModal] postMessage descartado: formUrl inválida', { formUrl });
      return;
    }

    if (e.origin !== allowedOrigin) {
      console.warn('[CotizacionModal] postMessage descartado: origin no permitido', {
        received: e.origin,
        allowed: allowedOrigin,
      });
      return;
    }

    const data = e.data as AmdPostMessage;
    if (data?.type !== 'amd-lead-submitted') return;

    closeModal();

    // Redirigir según idioma
    const lang = modal.dataset.lang ?? 'es';
    const thankYouPath = lang === 'en' ? '/en/thank-you-quote' : '/gracias-cotizacion';
    window.location.href = thankYouPath;
  }

  // ─── Inicialización ──────────────────────────────────────────────────────────

  function init() {
    const modal = getModal();
    if (!modal) return;

    // Backdrop — cierra al hacer click fuera del panel
    const backdrop = document.getElementById('cotizacion-backdrop');
    backdrop?.addEventListener('click', closeModal);

    // Botón X
    const closeBtn = document.getElementById('cotizacion-close');
    closeBtn?.addEventListener('click', closeModal);

    // Escape cierra el modal
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isModalOpen) {
        e.preventDefault();
        closeModal();
      }
    });

    // Spinner: ocultar cuando el iframe termina de cargar
    const iframe = getIframe();
    const spinner = getSpinner();
    iframe?.addEventListener('load', () => {
      iframe.classList.add('is-loaded');
      spinner?.classList.add('is-hidden');
    });

    // Escuchar postMessage del form standalone
    window.addEventListener('message', handleIframeMessage);

    // Escuchar el evento custom que emite CotizacionFormPreview
    document.addEventListener('amd:open-modal', openModal);
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
