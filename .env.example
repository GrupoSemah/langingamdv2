# Kommo CRM (contact.js)
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
KOMMO_USER_ID=
KOMMO_EMAIL_FIELD_ID=
KOMMO_PHONE_FIELD_ID=
KOMMO_SUCURSAL_FIELD_ID=
KOMMO_FUENTE_LEAD_ID=
KOMMO_FUENTE_LEAD_ENUM_ID=

# Reporte protegido (reporte.js)
REPORTE_SECRET=

# Mapbox
MAPBOX_TOKEN=
MAPBOX_TOKEN_TEST=

# URL publica del formulario standalone (iframe del modal de cotizacion) — expuesta al cliente
PUBLIC_FORM_URL=http://localhost:4322

# ── WhatsApp lead capture proxy (src/pages/api/whatsapp-lead.ts) ──────────────
# URL server-to-server del servicio interno de form-almacenajes que resuelve la
# integracion real con Kommo (busqueda/dedupe/creacion de lead). NUNCA usar el
# prefijo PUBLIC_ aqui: es una llamada servidor-a-servidor, no debe exponerse al
# bundle del cliente. En dev normalmente coincide con el mismo host:puerto que
# PUBLIC_FORM_URL (ej. http://localhost:4322); en prod es un dominio distinto.
FORM_SERVICE_INTERNAL_URL=

# Secreto compartido enviado como header X-Internal-Key en la llamada anterior.
# Debe coincidir con el valor configurado del lado de form-almacenajes.
INTERNAL_API_KEY=

# Kill switch del lado del frontend: si es "false", el modal de captura no debe
# intentar el POST a /api/whatsapp-lead. Ver nota de gap en el reporte del agente
# — WhatsAppPhoneModal.tsx todavia no lee esta variable.
PUBLIC_WHATSAPP_CAPTURE_ENABLED=true

# ── Cloudflare Turnstile (anti-abuso del modal de WhatsApp) ───────────────────
# Site key publica del widget, resuelta en Layout.astro y pasada como prop a
# WhatsAppPhoneModal.tsx. Debe corresponder al dominio configurado en Cloudflare.
PUBLIC_TURNSTILE_SITE_KEY=

# Secreto usado SOLO server-side en src/pages/api/whatsapp-lead.ts para verificar
# el token contra https://challenges.cloudflare.com/turnstile/v0/siteverify.
# NUNCA usar el prefijo PUBLIC_ aqui.
TURNSTILE_SECRET_KEY=
